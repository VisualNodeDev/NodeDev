@using NodeDev.Core;
@using NodeDev.Core.Class;
@using System.Reactive.Linq;
@using NodeDev.Blazor.Services
@implements IDisposable
@inject SourceGenerationService SourceGenerationService

@using BlazorMonaco
@using BlazorMonaco.Editor
@using BlazorMonaco.Languages

<style>
    .sourceViewer, .sourceViewer > .mud-tabs-panels {
    width: 100%;
    height: 100%
    }
</style>

@if (Method == null || CodeCs == null)
{
    <MudText Typo="Typo.caption">Open a method to view its generated source code</MudText>
}
else
{
    <MudTabs Class="sourceViewer">
        <MudTabPanel Text="Generated C#" Class="wh100">
            <StandaloneCodeEditor @key="CodeCs.GetHashCode().ToString()" ConstructionOptions="@(x => EditorConstructionOptions(x, CodeCs, "csharp"))" CssClass="wh100" />
        </MudTabPanel>
        <MudTabPanel Text="IL Code" Class="wh100">
            <MudText Typo="Typo.body1" Style="padding: 16px;">IL code viewer will be added in a future update.</MudText>
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public NodeClassMethod? Method { get; set; }

    [Parameter]
    public bool IsVisible { get; set; }

    private NodeClassMethod? PreviousMethod { get; set; }

    private IDisposable? GraphChangedSubscription { get; set; }

    private CancellationTokenSource? GenerationCancellation { get; set; }

    private string? CodeCs;

    private StandaloneEditorConstructionOptions EditorConstructionOptions(StandaloneCodeEditor editor, string code, string language)
    {
        return new()
            {
                ReadOnly = true,
                Value = code,
                Language = language,
                AutomaticLayout = true,
                Minimap = new()
                {
                    Enabled = false
                }
            };
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (!IsVisible)
        {
            GraphChangedSubscription?.Dispose();
            GraphChangedSubscription = null;
            GenerationCancellation?.Cancel();
            return;
        }

        if (Method != PreviousMethod || (Method != null && GraphChangedSubscription == null))
        {
            GraphChangedSubscription?.Dispose();
            GraphChangedSubscription = null;
			GenerationCancellation?.Cancel();
			GenerationCancellation?.Dispose();
			GenerationCancellation = null;

            PreviousMethod = Method;
            CodeCs = null;

            if (Method != null)
            {
                var method = Method;
                GraphChangedSubscription = method.Graph.Project.GraphChanged
                    .Where(change => change.Graph == method.Graph)
                    .AcceptThenSample(TimeSpan.FromSeconds(1))
                    .Subscribe(change =>
                    {
                        _ = InvokeAsync(() => QueueSourceRefresh(method));
                    });
                QueueSourceRefresh(method);
            }
        }
    }

    private void QueueSourceRefresh(NodeClassMethod method)
    {
        GenerationCancellation?.Cancel();
        GenerationCancellation?.Dispose();
        GenerationCancellation = new CancellationTokenSource();
        _ = GenerateSourceAsync(method, GenerationCancellation.Token);
    }

    private async Task GenerateSourceAsync(NodeClassMethod method, CancellationToken cancellationToken)
    {
        try
        {
            var generatedCode = await SourceGenerationService.GenerateCSharpAsync(method, cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            CodeCs = generatedCode == null
                ? "// Unable to retrieve generated code for this method"
                : $"// Generated code from NodeDev visual programming{System.Environment.NewLine}// This is the actual C# code that gets compiled and executed{System.Environment.NewLine}{System.Environment.NewLine}{generatedCode}";
        }
        catch (BuildError buildError)
        {
            CodeCs = $"/* Error during code generation of node {buildError.Node.Name}: {System.Environment.NewLine}{buildError.Message}{System.Environment.NewLine}";

            if (buildError.InnerException != null)
                CodeCs += $"{System.Environment.NewLine}Inner exception:{System.Environment.NewLine}{buildError.InnerException}";

            CodeCs += $"{System.Environment.NewLine}*/";
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            CodeCs = $"/* Error during code generation: {System.Environment.NewLine}{ex}{System.Environment.NewLine}*/";
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GraphChangedSubscription?.Dispose();
        GenerationCancellation?.Cancel();
        GenerationCancellation?.Dispose();
    }
}
