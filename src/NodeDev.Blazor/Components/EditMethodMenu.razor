@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NodeDev.Blazor.Services.WorkspaceCommandService Commands

<MudDialog>
    <DialogContent>
        <div style="height: 50vh; width: 100%; display: flex; flex-direction: column">
            <MudText Typo="Typo.h2">@Method.Name</MudText>
            
            <div style="display: flex; gap: 8px; margin: 8px 0;">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddParameter" Class="px-8" data-test-id="add-parameter">Add parameter</MudButton>
            </div>

            <MudDataGrid Items="Method.Parameters" EditMode="DataGridEditMode.Cell" ReadOnly="false" Class="w100 flex-1">
                <Columns>
                    <TemplateColumn Title="Type" Editable="false">
                        <CellTemplate>
                            <div style="display: grid; grid-template-columns: 1fr auto; align-items: center; width: 100%">
                                <MudText>@context.Item.ParameterType.FriendlyName</MudText>
                                <div style="justify-self: end;">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="() => ShowParameterTypeEdit(context.Item)"></MudIconButton>
                                </div>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    <CallbackSetColumn T="NodeDev.Core.Class.NodeClassMethodParameter" TProperty="string" Property="x => x.Name" SetCallback="RenameParameter" Editable="true" data-test-id="param-name-input" />

                    <TemplateColumn Title="IsOut">
                        <EditTemplate>
                            <MudCheckBox T="bool" Value="context.Item?.IsOut ?? false" ValueChanged="@(v => SetParameterIsOut(context.Item, v))"></MudCheckBox>
                        </EditTemplate>
                    </TemplateColumn>

                    <TemplateColumn Editable="false">

                        <CellTemplate>

                            <div style="display: flex; flex-direction: row">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" OnClick="() => MoveParameterUp(context.Item)" Disabled="Method.Parameters.FirstOrDefault() == context.Item"></MudIconButton>
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" OnClick="() => MoveParameterDown(context.Item)" Disabled="Method.Parameters.LastOrDefault() == context.Item"></MudIconButton>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="() => RemoveParameter(context.Item)"></MudIconButton>
                            </div>

                        </CellTemplate>

                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        </div>

    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Close</MudButton>
    </DialogActions>
</MudDialog>


@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public NodeDev.Core.Class.NodeClassMethod Method { get; set; } = null!;

    /// <summary>
    /// Closes the editor after its immediate parameter mutations have been applied.
    /// </summary>
    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    /// <summary>
    /// Adds the default parameter defined by the core model and refreshes the grid.
    /// </summary>
    private void AddParameter()
    {
        ShowFailure(Commands.AddDefaultParameter(Method));
        StateHasChanged();
    }

    /// <summary>
    /// Opens the type selector for a method parameter.
    /// </summary>
    /// <param name="parameter">The parameter that receives the selected type.</param>
    private async Task ShowParameterTypeEdit(NodeDev.Core.Class.NodeClassMethodParameter parameter)
    {
        var dialog = await DialogService.ShowAsync<TypeSelectorDialog>("Select Parameter Type", new()
            {
                [nameof(TypeSelectorDialog.TypeFactory)] = Method.Class.TypeFactory
            }, DialogDefaults.TypeSelector);
        var result = await dialog.Result;

        if (result?.Data is NodeDev.Core.Types.TypeBase type)
        {
            ShowFailure(Commands.ChangeParameterType(parameter, type));
        }
    }

    /// <summary>
    /// Applies an inline name edit through the workspace command boundary.
    /// </summary>
    /// <param name="parameter">The parameter being renamed.</param>
    /// <param name="name">The edited name, which may be empty while editing.</param>
    private void RenameParameter(NodeDev.Core.Class.NodeClassMethodParameter parameter, string? name)
    {
        ShowFailure(Commands.RenameParameter(parameter, name ?? ""));
    }

    /// <summary>
    /// Applies the output-parameter toggle when the grid has a valid row item.
    /// </summary>
    /// <param name="parameter">The optional parameter from the grid row.</param>
    /// <param name="value">Whether the parameter should be emitted as <see langword="out"/>.</param>
    private void SetParameterIsOut(NodeDev.Core.Class.NodeClassMethodParameter? parameter, bool value)
    {
        if (parameter != null)
        {
            ShowFailure(Commands.SetParameterIsOut(parameter, value));
        }
    }

    /// <summary>
    /// Moves a parameter earlier in the method signature.
    /// </summary>
    /// <param name="parameter">The parameter to move.</param>
    private void MoveParameterUp(NodeDev.Core.Class.NodeClassMethodParameter parameter)
    {
        ShowFailure(Commands.MoveParameterUp(parameter));
    }

    /// <summary>
    /// Moves a parameter later in the method signature.
    /// </summary>
    /// <param name="parameter">The parameter to move.</param>
    private void MoveParameterDown(NodeDev.Core.Class.NodeClassMethodParameter parameter)
    {
        ShowFailure(Commands.MoveParameterDown(parameter));
    }

    /// <summary>
    /// Removes a parameter from the method signature.
    /// </summary>
    /// <param name="parameter">The parameter to remove.</param>
    private void RemoveParameter(NodeDev.Core.Class.NodeClassMethodParameter parameter)
    {
        ShowFailure(Commands.RemoveParameter(parameter));
    }

    /// <summary>
    /// Displays only failed command outcomes because successful inline edits do not require a toast.
    /// </summary>
    /// <param name="result">The command outcome to inspect.</param>
    private void ShowFailure(NodeDev.Blazor.Services.WorkspaceCommandResult result)
    {
        if (!result.Succeeded)
        {
            Snackbar.ShowCommandResult(result);
        }
    }
}
