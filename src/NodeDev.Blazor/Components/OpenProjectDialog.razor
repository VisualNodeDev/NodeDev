<MudDialog>
    <DialogContent>
        <MudStack>
            <MudPaper Class="full-width">
                <MudList T="string" @bind-SelectedValue="ProjectName" ReadOnly="false">
                    @foreach (var item in ProjectNames)
                    {
                        <MudListItem Text="@item" />
                    }
                </MudList>
            </MudPaper>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@string.IsNullOrWhiteSpace(ProjectName)">Open</MudButton>
        <MudButton Color="Color.Primary" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public IReadOnlyList<string> ProjectNames { get; set; } = [];

    private string? ProjectName { get; set; }

    /// <summary>
    /// Closes the dialog without selecting a project.
    /// </summary>
    private void Cancel()
    {
        MudDialog.Cancel();
    }

    /// <summary>
    /// Returns the selected project name when one has been selected.
    /// </summary>
    private void Submit()
    {
        if (!string.IsNullOrWhiteSpace(ProjectName))
        {
            MudDialog.Close(DialogResult.Ok(ProjectName));
        }
    }
}
