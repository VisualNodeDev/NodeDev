<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="ProjectName" Label="File Name" Variant="Variant.Text" data-test-id="saveAsProjectName" Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@string.IsNullOrWhiteSpace(ProjectName)" data-test-id="saveAsSave">Save</MudButton>
        <MudButton Color="Color.Primary" OnClick="Cancel" data-test-id="saveAsCancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string? ProjectName { get; set; }

    /// <summary>
    /// Closes the dialog without saving the project.
    /// </summary>
    private void Cancel()
    {
        MudDialog.Cancel();
    }

    /// <summary>
    /// Returns the requested project name to the toolbar.
    /// </summary>
    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(ProjectName));
    }
}
