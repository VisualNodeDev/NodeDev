@using NodeDev.Core.Types;

<div style="@($"position: absolute; left: {PositionX - 250}px; top: {PositionY - 30}px; width: 500px; height: 400px")" @onclick:stopPropagation="true">

    <MudPaper Style="height: 100%; width: 100%">

        <MudStack Style="height: 100%; width: 100%" Class="pa-3">

            <MudTextField T="string" AutoFocus="true" @bind-Value="SearchText" @bind-Value:after="UpdateSearchResults" Immediate="true" DebounceInterval="150" Label="Search" Class="flex-none" OnKeyDown="OnKeyDown" data-test-id="node-search-input"></MudTextField>

            <MudList T="NodeDev.Core.NodeProvider.NodeSearchResult" SelectedValueChanged="@( x => OnNodeTypeSelected.InvokeAsync(x))" Class="flex-1 overflow-y-scroll">
                @foreach (var type in SearchResults)
                {
                    @if (type is NodeDev.Core.NodeProvider.MethodCallNode methodCallNode)
                    {
                        <MudListItem Text="@($"{methodCallNode.MethodInfo.DeclaringType.FriendlyName}.{methodCallNode.MethodInfo.Name}({string.Join(',', methodCallNode.MethodInfo.GetParameters().Select( x=> x.FriendlyFormat()))})")" Value="type" data-test-id="node-search-result" data-node-type="@type.Type.Name" />
                    }
                    else if (type is NodeDev.Core.NodeProvider.GetPropertyOrFieldNode getPropertyOrFieldNode)
                    {
                        <MudListItem Text="@($"{getPropertyOrFieldNode.MemberInfo.DeclaringType.FriendlyName}.{getPropertyOrFieldNode.MemberInfo.Name}")" Value="type" data-test-id="node-search-result" data-node-type="@type.Type.Name" />
                    }
                    else if (type is NodeDev.Core.NodeProvider.SetPropertyOrFieldNode setPropertyOrFieldNode)
                    {
                        <MudListItem Text="@($"{setPropertyOrFieldNode.MemberInfo.DeclaringType.FriendlyName}.{setPropertyOrFieldNode.MemberInfo.Name}")" Value="type" data-test-id="node-search-result" data-node-type="@type.Type.Name" />
                    }
                    else
                    {
                        <MudListItem Text="@type.Type.Name" Value="type" data-test-id="node-search-result" data-node-type="@type.Type.Name" />
                    }
                }
            </MudList>

        </MudStack>


    </MudPaper>
</div>

@code {

    [Parameter]
    public int PositionX { get; set; }

    [Parameter]
    public int PositionY { get; set; }

    [Parameter]
    public NodeDev.Core.Connections.Connection? Connection { get; set; } = null!;

    [Parameter]
    public string? CallableScopeId { get; set; }

    [Parameter]
    public GraphCanvas GraphCanvas { get; set; } = null!;

    [Parameter]
    public EventCallback<NodeDev.Core.NodeProvider.NodeSearchResult> OnNodeTypeSelected { get; set; }

    private const int MaxSearchResults = 100;
    private string SearchText { get; set; } = "";
    private IReadOnlyList<NodeDev.Core.NodeProvider.NodeSearchResult> SearchResults { get; set; } = [];
    private NodeDev.Core.Graph? LastGraph;
    private NodeDev.Core.Connections.Connection? LastConnection;
    private string? LastCallableScopeId;

    protected override void OnParametersSet()
    {
        var graph = GraphCanvas.Graph;
        if (graph == LastGraph && Connection == LastConnection && CallableScopeId == LastCallableScopeId)
            return;

        LastGraph = graph;
        LastConnection = Connection;
        LastCallableScopeId = CallableScopeId;
        UpdateSearchResults();
    }

    private void UpdateSearchResults()
    {
        SearchResults = NodeDev.Core.NodeProvider
            .Search(GraphCanvas.Graph, SearchText, Connection, CallableScopeId)
            .Take(MaxSearchResults)
            .ToList();
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            var first = SearchResults.FirstOrDefault();
            if (first != null)
                await OnNodeTypeSelected.InvokeAsync(first);
        }
    }
}
